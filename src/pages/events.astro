---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/events/Hero.astro";
import UpcomingEvents from "../components/events/UpcomingEvents.astro";
import EventFormats from "../components/events/EventFormats.astro";
import EventsCTA from "../components/events/EventsCTA.astro";
import { getEntry } from "astro:content";
import "../styles/events.css";

const entry = await getEntry("events", "events");
const data = entry.data;

/**
 * There is no sample/dummy event data to fall back to — with only a handful
 * of real events at a time, hand-written placeholders would either go stale
 * or duplicate what Eventbrite already has. The featured card, event grid
 * and past events are populated entirely client-side by
 * src/scripts/eventbrite-live.js from a public n8n webhook; if that fetch
 * fails or Eventbrite has nothing live, the page just shows the "no events
 * right now" message below with a way to get in touch, never fake events.
 */

const seoTitle = "Events, Webinars & Workshops - Digital Back Office";
const seoDescription =
  "Join Digital Back Office for live webinars, hands-on workshops, executive roundtables and conferences on AI adoption, data engineering and AI governance.";
const seoKeywords =
  "AI events, AI webinars, data engineering workshop, AI governance roundtable, machine learning conference UK, enterprise AI events";
---

<Layout
  title={seoTitle}
  description={seoDescription}
  keywords={seoKeywords}
  canonical="/events"
>
  <main class="page-wrapper events-page">
    <Hero {...data.hero} />
    {/*
      The skeletons below sit inside the very nodes the live schedule replaces,
      so there is nothing to hide once the data lands — it simply overwrites
      them. They stand in for the seconds the webhook takes to answer on a
      first visit; a returning visitor paints straight from the cache instead.
    */}
    <div id="featured-event-root">
      <section class="events-section events-section--tight" data-events-skeleton aria-hidden="true">
        <div class="container">
          <article class="featured-event">
            <div class="featured-event-body events-skeleton-stack">
              <span class="events-skeleton-line events-skeleton-line--short"></span>
              <span class="events-skeleton-line events-skeleton-line--title"></span>
              <span class="events-skeleton-line events-skeleton-line--title events-skeleton-line--long"></span>
              <span class="events-skeleton-line events-skeleton-line--long"></span>
              <span class="events-skeleton-line events-skeleton-line--medium"></span>
            </div>
            <div class="featured-event-aside events-skeleton-stack">
              <span class="events-skeleton-media"></span>
              <span class="events-skeleton-line events-skeleton-line--medium"></span>
              <span class="events-skeleton-line events-skeleton-line--long"></span>
              <span class="events-skeleton-line events-skeleton-line--medium"></span>
              <span class="events-skeleton-button"></span>
            </div>
          </article>
        </div>
      </section>
    </div>
    <UpcomingEvents
      title={data.upcoming.title}
      subtitle={data.upcoming.subtitle}
      empty_message={data.upcoming.empty_message}
      host_cta={data.hero.secondary_cta}
    />
    <EventFormats {...data.formats} />
    <div
      id="past-events-root"
      data-badge={data.past.badge}
      data-title={data.past.title}
      data-subtitle={data.past.subtitle}
    ></div>
    <EventsCTA {...data.cta} />
  </main>

  {/*
    Without JavaScript nothing ever replaces the skeletons, so they come out
    and the honest empty state — which is otherwise revealed by the script —
    stands in their place. `is:inline` keeps Astro from lifting this out of the
    <noscript> and applying it to every visitor.
  */}
  <noscript>
    <style is:inline>
      [data-events-skeleton] { display: none !important; }
      .events-empty { display: block; }
    </style>
  </noscript>

  <script src="/src/scripts/eventbrite-live.js"></script>
</Layout>
