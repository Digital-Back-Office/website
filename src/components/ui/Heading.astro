---
export interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  size?: "xs" | "sm" | "md" | "lg" | "xl" | "2xl" | "3xl" | "4xl" | "5xl" | "6xl";
  align?: "left" | "center" | "right";
  class?: string;
}

const { level = 2, size, align = "left", class: className = "" } = Astro.props;

const sizeMap: Record<number, string> = {
  1: "5xl",
  2: "4xl",
  3: "3xl",
  4: "2xl",
  5: "xl",
  6: "lg"
};

const tagMap = {
  1: "h1",
  2: "h2",
  3: "h3",
  4: "h4",
  5: "h5",
  6: "h6"
} as const;

const resolvedSize = size ?? sizeMap[level];
const Tag = tagMap[level];
const classes = [
  "ui-heading",
  `ui-heading--${resolvedSize}`,
  `ui-heading--${align}`,
  className
]
  .filter(Boolean)
  .join(" ");
---

<Tag class={classes}>
  <slot />
</Tag>

<style>
  /* Sizes map onto the shared role tokens rather than a parallel raw scale,
     so <Heading> and a hand-written <h2> are always the same heading. */
  .ui-heading {
    font-family: var(--font-sans);
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
    letter-spacing: var(--ls-heading);
    color: var(--text-primary);
    margin: 0;
  }

  .ui-heading--left {
    text-align: left;
  }

  .ui-heading--center {
    text-align: center;
  }

  .ui-heading--right {
    text-align: right;
  }

  .ui-heading--xs {
    font-size: var(--fs-eyebrow);
    font-weight: var(--fw-extrabold);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
  }

  .ui-heading--sm {
    font-size: var(--fs-body-sm);
    letter-spacing: var(--ls-normal);
  }

  .ui-heading--md {
    font-size: var(--fs-body);
    letter-spacing: var(--ls-normal);
  }

  .ui-heading--lg {
    font-size: var(--fs-title-sm);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-snug);
  }

  .ui-heading--xl,
  .ui-heading--2xl {
    font-size: var(--fs-card);
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-snug);
  }

  .ui-heading--3xl,
  .ui-heading--4xl {
    font-size: var(--fs-subsection);
  }

  .ui-heading--5xl {
    font-size: var(--fs-section);
    font-weight: var(--fw-extrabold);
  }

  .ui-heading--6xl {
    font-size: var(--fs-hero);
    font-weight: var(--fw-extrabold);
    line-height: var(--lh-hero);
    letter-spacing: var(--ls-hero);
  }
</style>
