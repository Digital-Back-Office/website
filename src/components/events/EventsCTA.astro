---
import Button from "../ui/Button.astro";

export interface Props {
  title: string;
  description: string;
  primary_cta: { label: string; href: string };
  secondary_cta: { label: string; href: string };
  points: string[];
}

const { title, description, primary_cta, secondary_cta, points } = Astro.props;
---

<section class="events-section">
  <div class="container">
    <div class="events-cta-panel">
      <div>
        <h2 class="events-cta-title">{title}</h2>
        <p class="events-cta-desc">{description}</p>
        <div class="events-cta-actions">
          <Button href={primary_cta.href} variant="primary" size="lg">
            {primary_cta.label}
          </Button>
          <Button href={secondary_cta.href} variant="outline" size="lg">
            {secondary_cta.label}
          </Button>
        </div>
      </div>

      <ul class="events-cta-points">
        {
          points.map((point) => (
            <li>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
