    <!-- testimonials -->
    <div class="container position-relative z-1 testimonials-section">
        <div class="testimonials-header">
            <div class="expertise-badge">
                <span class="expertise-badge-text">Testimonials</span>
            </div>
            <h2 class="solutions-title">What Our Clients Say</h2>
        </div>
        <div class="testimonials-wrap">
            <!-- Each slide carries its own attribution, the same anatomy as the
                 case study card, so nothing depends on a JS binding to a
                 separate column. -->
            <div class="testimonial-head d-flex align-items-start justify-content-between">
                <span class="testimonial-quote-mark" aria-hidden="true">“</span>

                <!-- Swiper controls (Prev / Next) -->
                <div class="testimonial-nav d-flex align-items-center">
                    <button
                        class="btn btn-icon btn-sm btn-outline-primary btn-nav-testimonial rounded-circle me-3"
                        type="button"
                        id="prev-testimonial"
                        aria-label="Previous testimonial"
                    >
                        <i class="ai-arrow-left"></i>
                    </button>
                    <div
                        class="testimonials-count fw-medium flex-shrink-0 text-center text-body"
                        style="width: 2.5rem;"
                    >
                    </div>
                    <button
                        class="btn btn-icon btn-sm btn-outline-primary btn-nav-testimonial rounded-circle ms-3"
                        type="button"
                        id="next-testimonial"
                        aria-label="Next testimonial"
                    >
                        <i class="ai-arrow-right"></i>
                    </button>
                </div>
            </div>

            <div
                class="custom-swiper"
                data-swiper-options={`{
                    "spaceBetween": 40,
                    "loop": true,
                    "autoHeight": true,
                    "pagination": {
                        "el": ".testimonials-count",
                        "type": "fraction"
                    },
                    "navigation": {
                        "prevEl": "#prev-testimonial",
                        "nextEl": "#next-testimonial"
                    }
                }`}
            >
                <div class="swiper-wrapper">
                    {
                        testimonials.map((testimonial) => (
                            <div class="swiper-slide">
                                <h3 class="h4 mb-3 text-body testimonial-title">
                                    {testimonial.title}
                                </h3>
                                <p class="text-body-secondary testimonial-text">
                                    {testimonial.desc}
                                </p>
                                <div class="testimonial-author">
                                    {testimonial.image && (
                                        <img
                                            class="testimonial-avatar"
                                            src={testimonial.image}
                                            alt={testimonial.image_alt || `${testimonial.name}, ${testimonial.designation}`}
                                            width="112"
                                            height="112"
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    )}
                                    <div>
                                        <h4 class="h6 mb-0 text-body testimonial-name">
                                            {testimonial.name}
                                        </h4>
                                        <p class="mb-0 testimonial-role">
                                            {testimonial.designation}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>
