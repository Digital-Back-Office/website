---
import { getEntry } from "astro:content";

const Data = await getEntry("home", "home");
const testimonials = Data.data.testimonials;
const tech = Data.data.tech;
---

<style>
    .tech {
        padding: var(--space-10) 0;
    }

    .open-source .swiper-slide {
        /* width: 11rem; */
        /* height: 6.25rem; */
        overflow: hidden;
    }

    .tech-logo {
        display: flex;
        width: 100%;
        height: 100%;
        justify-content: center;
        align-items: center;
        background-color: var(--bg-surface);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border-subtle);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }
    .testimonials-header {
        text-align: center;
    }

    @media (max-width: 768px) {
        .open-source .swiper-slide {
            /* width: 11rem; */
            height: 5rem;
        }
    }

    @media (min-width: 1600px) {
        .open-source .swiper-slide {
            /* height: 10rem; */
        }
    }

    @media (min-width: 1024px) {
        .testimonials-section {
            min-height: 70vh;
        }
    }

    .tech-header {
        text-align: center;
        margin-bottom: var(--space-10);
    }

    .tech-title {
        font-size: var(--fs-section);
        font-weight: var(--fw-extrabold);
        line-height: var(--lh-heading);
        letter-spacing: var(--ls-heading);
        color: var(--text-primary);
    }

    .tech-subtitle {
        color: var(--text-secondary);
        font-size: var(--fs-lead);
        line-height: var(--lh-body);
        max-width: 720px;
        margin: var(--space-3) auto 0;
    }

    /* Same card as the case study pages: square except the top right, brand
       cyan on the left rule only, and a hard grey slab bottom left. */
    .testimonials-wrap {
        margin: var(--space-8) auto 0;
        max-width: 900px;
        background: var(--bg-surface, #ffffff);
        border: 1px solid var(--border-subtle);
        border-left: 3px solid var(--brand-cyan);
        border-radius: 0 var(--radius-lg) 0 0;
        box-shadow: -16px 16px 0 0 var(--border-strong);
        padding: var(--space-8);
    }

    .testimonial-quote-mark {
        font-family: Georgia, "Times New Roman", serif;
        font-size: var(--fs-quote-mark);
        line-height: 0.7;
        color: var(--brand-cyan);
    }

    .testimonial-title {
        font-size: var(--fs-card);
        font-weight: var(--fw-bold);
        line-height: var(--lh-snug);
        letter-spacing: var(--ls-snug);
        color: var(--text-primary);
    }

    .testimonial-text {
        font-size: var(--fs-body);
        line-height: var(--lh-relaxed);
        color: var(--text-secondary);
    }

    .testimonial-author {
        display: flex;
        align-items: center;
        gap: var(--space-4);
    }

    .testimonial-avatar {
        flex-shrink: 0;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--border-subtle);
    }

    .testimonial-author {
        margin-top: var(--space-6);
    }

    .testimonial-name {
        font-size: var(--fs-body);
        font-weight: var(--fw-bold);
        color: var(--text-primary);
    }

    .testimonial-role {
        font-size: var(--fs-body-sm);
        color: var(--text-muted);
    }

    .testimonial-head {
        margin-bottom: var(--space-4);
    }
</style>

<script>
    import Swiper from "swiper/bundle";
    import "swiper/css/navigation";
    import "swiper/css/pagination";
    import "swiper/css/bundle";

    const carousels = Array.from(document.querySelectorAll(".custom-swiper"));

    carousels.forEach((value) => {
        value.classList.add("swiper");
        let options;
        const htmlValueElement = value as HTMLElement;
        if (htmlValueElement.dataset.swiperOptions != undefined)
            options = JSON.parse(htmlValueElement.dataset.swiperOptions);

        const swiper = new Swiper(htmlValueElement, options); // eslint-disable-line no-undef

        // Binded content
        if (options.bindedContent) {
            swiper.on("activeIndexChange", (e: any) => {
                const targetItem = document.querySelector(
                    e.slides[e.activeIndex].dataset.swiperBinded,
                );
                const previousItem = document.querySelector(
                    e.slides[e.previousIndex].dataset.swiperBinded,
                );

                previousItem.classList.remove("active");
                targetItem.classList.add("active");
            });
        }
    });
</script>

