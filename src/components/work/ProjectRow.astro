---
import type { CollectionEntry } from 'astro:content';
import MediaPlaceholder from './MediaPlaceholder.astro';

export interface Props {
  project: CollectionEntry<'projects'>;
  linkLabel: string;
  /** Rows alternate the media side down the page. */
  index: number;
}

const { project, linkLabel, index } = Astro.props;
const data = project.data;
const href = `/work/${project.slug}/`;
const flipped = index % 2 === 1;
---

<article class={`work-row ${flipped ? 'work-row--flipped' : ''}`.trim()}>
  <div class="work-row-media">
    {data.cover_image ? (
      <img
        src={data.cover_image}
        alt=""
        loading={index > 1 ? 'lazy' : 'eager'}
        decoding="async"
        width="800"
        height="450"
      />
    ) : (
      <MediaPlaceholder label={data.client} />
    )}
  </div>

  <div class="work-row-body">
    <p class="work-row-client">{data.client}</p>
    <h2 class="work-row-title">
      <a href={href}>{data.tagline}</a>
    </h2>
    <p class="work-row-text">{data.summary}</p>

    {data.services.length > 0 && (
      <ul class="work-row-tags">
        {data.services.map((service) => (
          <li class="work-row-tag">{service}</li>
        ))}
      </ul>
    )}

    <span class="work-row-link" aria-hidden="true">
      {linkLabel}
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </span>
  </div>
</article>
