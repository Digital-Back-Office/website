---
import { getEntry } from "astro:content";

const Data = await getEntry("startups", "startups");
const pricing = Data.data.pricing;
---

<section class="pricing-section" id="offer">
  <div class="container">
    <div class="text-center mb-5">
      <div
        class="badge-container mb-3"
        style="display: inline-block; background-color: rgba(82, 206, 199, 0.1); border-radius: 50px; padding: 0.35rem 1.25rem; border: 1px solid rgba(82, 206, 199, 0.2);"
      >
        <span
          class="eyebrow"
          >{pricing.badge}</span
        >
      </div>
      <h2 class="text-dark">
        {pricing.title}
      </h2>
      <p class="text-dark opacity-70 max-width-700 mx-auto">
        {pricing.subtitle}
      </p>
    </div>

    <div class="pricing-single-wrapper">
      <!-- Card: Core Startup Pod -->
      <div class="pricing-premium-card primary-pod single-card">
        <div class="card-content">
          <div
            class="card-header-top d-flex flex-wrap justify-content-between align-items-center mb-4"
          >
            <div>
              <div class="card-badge mb-2">{pricing.package_label}</div>
              <h3 class="card-plan-title mb-0">{pricing.plan_title}</h3>
            </div>
            <div class="price-block text-md-end mt-3 mt-md-0">
              <div class="price-container mb-0">
                <span class="currency">{pricing.currency}</span>
                <span class="amount">{pricing.amount}</span>
                <span class="period">{pricing.period}</span>
              </div>
              <div class="savings-capsule mt-2 mb-0">
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  class="me-1"
                >
                  <path
                    d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                  ></path>
                </svg>
                {pricing.savings_text}
              </div>
            </div>
          </div>

          <p class="card-plan-desc-single mb-4">
            {pricing.description}
          </p>

          <hr class="card-divider" />

          <h4
            class="eyebrow text-dark mb-3" style="opacity: 0.6;"
          >
            {pricing.features_label}
          </h4>

          <ul class="card-features-list card-features-grid mb-4">
            {pricing.features.map((feature: string) => (
              <li>
                <div class="check-icon">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                  >
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <a href="#claim-offer" class="btn-pricing-cta primary-btn mt-2">
            {pricing.cta_text}
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              class="ms-2"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Savings notice comparison -->
    <div class="pricing-comparison-footer text-center mt-5">
      <p class="text-dark opacity-60">
        {pricing.footer_text}
      </p>
    </div>
  </div>
</section>
