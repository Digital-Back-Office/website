---
import { getEntry } from "astro:content";

const Data = await getEntry("startups", "startups");
const howItWorks = Data.data.how_it_works;

// Decorative, index-keyed icons - not CMS fields, kept as-is.
const icons = [
  `<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline>`,
  `<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>`,
  `<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>`,
];
---

<section class="how-it-works" id="how-it-works">
  <div class="container">
    <div class="text-center mb-5">
      <div
        class="badge-container mb-3"
        style="display: inline-block; background-color: rgba(82, 206, 199, 0.1); border-radius: 50px; padding: 0.35rem 1.25rem; border: 1px solid rgba(82, 206, 199, 0.2);"
      >
        <span
          class="eyebrow"
          >{howItWorks.badge}</span
        >
      </div>
      <h2 class="text-dark">{howItWorks.title}</h2>
      <p class="text-dark opacity-70 max-width-600 mx-auto">
        {howItWorks.subtitle}
      </p>
    </div>

    <div class="row how-it-works-row g-4">
      {howItWorks.steps.map((step: any, index: number) => (
        <div class="col-lg-4">
          <div class="step-card">
            <div class="step-large-num">{String(index + 1).padStart(2, "0")}</div>
            <div class="step-icon-container">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#2E9691"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={icons[index]}
              />
            </div>
            <span class="step-badge">{step.phase}</span>
            <h3 class="h4 text-dark mb-3">{step.title}</h3>
            <p class="text-dark opacity-70 mb-0">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
