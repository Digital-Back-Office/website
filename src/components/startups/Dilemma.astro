---
import { getEntry } from "astro:content";

const Data = await getEntry("startups", "startups");
const dilemma = Data.data.dilemma;
---

<section class="dilemma-section" id="dilemma">
  <div class="container">
    <div class="text-center mb-5">
      <div
        class="badge-container mb-3"
        style="display: inline-block; background-color: rgba(82, 206, 199, 0.1); border-radius: 50px; padding: 0.35rem 1.25rem; border: 1px solid rgba(82, 206, 199, 0.2);"
      >
        <span
          class="eyebrow"
          >{dilemma.badge}</span
        >
      </div>
      <h2 class="text-dark">
        {dilemma.title}
      </h2>
      <p class="text-dark opacity-70 max-width-700 mx-auto">
        {dilemma.subtitle}
      </p>
    </div>

    <div class="comparison-container">
      <div class="comparison-table-grid">
        <!-- Table Header -->
        <div class="comparison-header-row">
          <div class="comparison-cell cell-feature">
            <span
              class="eyebrow opacity-50"
              >Metrics</span
            >
          </div>
          <div class="comparison-cell cell-inhouse">
            <div class="header-subtitle text-dark opacity-40">
              {dilemma.inhouse_subtitle}
            </div>
            <div class="header-title text-dark">{dilemma.inhouse_title}</div>
          </div>
          <div class="comparison-cell cell-pod">
            <div
              class="header-subtitle text-primary"
              style="color: #2E9691 !important;"
            >
              {dilemma.pod_subtitle}
            </div>
            <div class="header-title text-dark">{dilemma.pod_title}</div>
          </div>
        </div>

        {dilemma.rows.map((row: any) => (
          <div class="comparison-row">
            <div class="comparison-row-content">
              <div class="comparison-cell cell-feature">
                <span>{row.feature}</span>
              </div>
              <div class="comparison-cell cell-inhouse">
                <div class="value-highlight text-coral">{row.inhouse_value}</div>
                <div class="value-sub">{row.inhouse_sub}</div>
              </div>
              <div class="comparison-cell cell-pod">
                <div class="value-highlight text-cyan">{row.pod_value}</div>
                <div class="value-sub">{row.pod_sub}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
