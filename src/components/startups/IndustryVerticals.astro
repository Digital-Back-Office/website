---
import { getEntry } from "astro:content";

const Data = await getEntry("startups", "startups");
const industries = Data.data.industries;

// Decorative, index-keyed icons - not CMS fields, kept as-is; order must
// match startups.md's industries.cards order.
const icons = [
  `<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M12 2L2 7h20L12 2z"></path><path d="M6 11v7M10 11v7M14 11v7M18 11v7"></path>`,
  `<path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>`,
  `<path d="M2 20h20M20 20V8l-6 4V8l-6 4V4H4v16"></path>`,
  `<circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>`,
  `<line x1="18" y1="10" x2="18" y2="10.01"></line><line x1="12" y1="10" x2="12" y2="10.01"></line><line x1="6" y1="10" x2="6" y2="10.01"></line><line x1="18" y1="14" x2="18" y2="14.01"></line><line x1="12" y1="14" x2="12" y2="14.01"></line><line x1="6" y1="14" x2="6" y2="14.01"></line><rect x="2" y="2" width="20" height="20" rx="4" ry="4"></rect>`,
  `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline>`,
  `<path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"></path>`,
  `<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 14.66V17c0 .55-.45 1-1 1H4v2h16v-2h-5c-.55 0-1-.45-1-1v-2.34"></path><path d="M12 2a4 4 0 0 1 4 4v7a4 4 0 0 1-4 4 4 4 0 0 1-4-4V6a4 4 0 0 1 4-4z"></path>`,
  `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>`,
];
---

<section class="industry-verticals-section" id="industries">
  <div class="container">
    <div class="text-center mb-5">
      <div
        class="badge-container mb-3"
        style="display: inline-block; background-color: rgba(82, 206, 199, 0.1); border-radius: 50px; padding: 0.35rem 1.25rem; border: 1px solid rgba(82, 206, 199, 0.2);"
      >
        <span
          class="eyebrow"
          >{industries.badge}</span
        >
      </div>
      <h2 class="text-dark">{industries.title}</h2>
      <p class="text-dark opacity-70 max-width-700 mx-auto">
        {industries.subtitle}
      </p>
    </div>

    <div class="row g-4 justify-content-center">
      {industries.cards.map((card: any, index: number) => (
        <div class="col-lg-4 col-md-6">
          <a href={card.href} class="industry-card-link">
            <div class="industry-vertical-card">
              <div class="card-icon-container">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#2E9691"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[index]}
                />
              </div>
              <h3 class="h6 card-title">{card.title}</h3>
              <div class="arrow-wrap">
                <svg
                  class="arrow-icon"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#2E9691"
                  stroke-width="2"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Section Padding */
  .industry-verticals-section {
    padding: 7rem 0;
    position: relative;
    background: #ffffff;
  }

  /* Link Wrapper */
  .industry-card-link {
    text-decoration: none !important;
    display: block;
    height: 100%;
  }

  /* Rectangular Premium Card - Box design */
  .industry-vertical-card {
    display: flex;
    align-items: center;
    background: #ffffff;
    backdrop-filter: blur(12px);
    border: 1.5px solid rgba(82, 206, 199, 0.16);
    border-radius: 16px;
    padding: 1.35rem 1.6rem;
    height: 100%;
    transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
    box-shadow: 0 10px 30px rgba(20, 40, 40, 0.05);
  }

  /* Hover transitions */
  .industry-vertical-card:hover {
    transform: translateY(-4px);
    border-color: rgba(82, 206, 199, 0.5);
    background: #ffffff;
    box-shadow: 0 15px 35px rgba(82, 206, 199, 0.12);
  }

  /* Icon Container styling */
  .card-icon-container {
    width: 42px;
    height: 42px;
    background: rgba(82, 206, 199, 0.1);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #2e9691;
    margin-right: 1.15rem;
    transition: all 0.3s ease;
  }

  .industry-vertical-card:hover .card-icon-container {
    background: rgba(82, 206, 199, 0.2);
    box-shadow: 0 0 12px rgba(82, 206, 199, 0.2);
  }

  /* Card Title */
  .card-title {
    font-weight: var(--fw-bold);
    margin: 0;
    font-size: var(--fs-title-sm);
    color: #0f2523;
    transition: color 0.3s ease;
    flex-grow: 1;
    padding-right: 0.5rem;
    line-height: var(--lh-snug);
    letter-spacing: var(--ls-snug);
  }

  .industry-vertical-card:hover .card-title {
    color: #2e9691 !important;
  }

  /* Link Arrow wrapper styling */
  .arrow-wrap {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .arrow-icon {
    transform: translateX(0);
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
    opacity: 0.5;
  }

  .industry-vertical-card:hover .arrow-icon {
    transform: translateX(4px);
    opacity: 1;
  }
</style>
