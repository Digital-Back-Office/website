# Copy to .env and fill in. .env is gitignored.

# --- Existing integrations (client-side, hence PUBLIC_) ---
PUBLIC_GOOGLE_TAG_ID=
PUBLIC_FORM_ID=
PUBLIC_GOOGLE_APP_SCRIPT_ID=
PUBLIC_CALENDLY_AUTH=
PUBLIC_CLIENT_ID=
PUBLIC_API_KEY=

# --- Eventbrite live schedule (client-side) ---
# Powers /events. This is a public n8n webhook URL, not an API key — n8n holds
# the real Eventbrite token in its own environment, calls the Eventbrite API,
# and returns only the structured, already-public event data. The browser
# calls this webhook directly, so it is safe to expose (PUBLIC_) and must have
# CORS enabled for this site's origin on the n8n side.
# Leave blank locally — /events then shows its "no events right now" state.
PUBLIC_EVENTBRITE_WEBHOOK_URL=
